{
  "id": "devslibrary_accessibility",
  "title": "Web Accessibility: A Complete Practical Textbook",
  "slug": "accessibility",
  "version": "1.0.0",
  "description": "A practical, standards-informed textbook for building, testing, and maintaining accessible web experiences.",
  "audience": "Beginner to advanced web developers, designers, testers, and technical leads",
  "lesson_count": 38,
  "language": "en",
  "prerequisites": [
    "Basic HTML",
    "Basic CSS",
    "JavaScript fundamentals are helpful but not required"
  ],
  "learning_outcomes": [
    "Explain accessibility, disability models, assistive technology, and inclusive design.",
    "Build semantic, keyboard-operable interfaces with meaningful focus behavior.",
    "Create accessible forms, navigation, dialogs, tables, media, and dynamic updates.",
    "Use WCAG principles and success criteria as a practical engineering framework.",
    "Test with automated tools, keyboard-only workflows, screen readers, zoom, and manual review.",
    "Plan remediation, document exceptions, and embed accessibility into a team's delivery process."
  ],
