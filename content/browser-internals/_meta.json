  "slug": "browser-internals",
  "version": "1.0.0",
  "description": "A deep practical guide to browser architecture, parsing, rendering, JavaScript execution, networking, security, storage, accessibility APIs, performance, and debugging.",
  "audience": "Web developers from beginner to advanced",
  "lesson_count": 35,
  "language": "en",
  "prerequisites": [
    "Basic HTML and CSS",
    "JavaScript fundamentals",
    "Basic HTTP knowledge is helpful"
  ],
  "learning_outcomes": [
    "Trace navigation from URL resolution through resource loading and rendering.",
    "Explain DOM/CSS parsing, style calculation, layout, paint, rasterization, and compositing.",
    "Understand JavaScript scheduling, workers, memory management, and browser APIs.",
    "Reason about browser networking, caches, storage, service workers, and offline behavior.",
    "Understand origin boundaries, browser security mechanisms, permissions, and embedded contexts.",
    "Use developer tools and repeatable experiments to investigate performance and compatibility issues."
  ],
